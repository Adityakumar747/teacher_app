                  "        var firstSlot = json.data.classes[0];",
                  "        var sId = firstSlot.id || firstSlot._id;",
                  "        pm.collectionVariables.set(\"slotId\", sId);",
                  "        if (firstSlot.class && firstSlot.class.id) {",
