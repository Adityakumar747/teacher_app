{
  "info": {
    "name": "Sparkology Teacher & Attendance API",
    "_postman_id": "sparkology-api-collection",
    "description": "API collection for Sparkology Teacher App & Backend, covering Auth, Dashboard (classes-today), Slot Attendance, Bulk Attendance, Edit Window, and Attendance History.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "slotId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Teacher Login (JWT Dual Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@spark.edu\",\n  \"password\": \"teacher123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Login response returns success: true\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});",
                  "pm.test(\"JWT token is generated and stored in collection\", function () {",
                  "    var json = pm.response.json();",
                  "    var token = (json.data && json.data.token) ? json.data.token : json.token;",
                  "    pm.expect(token).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"authToken\", token);",
                  "});",
                  "pm.test(\"User profile has teacher role\", function () {",
                  "    var json = pm.response.json();",
                  "    var user = (json.data && json.data.user) ? json.data.user : json.user;",
                  "    pm.expect(user.role).to.eql(\"teacher\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current Profile (GET /api/teachers/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/teachers/me",
