        {
          "name": "Get Slot Attendance (Past Date - Edit Window & Lock Check)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/slot/{{slotId}}?date=2026-10-20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "slot",
                "{{slotId}}"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2026-10-20",
                  "description": "Date older than 7 days returns isLocked: true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Past date older than 7 days is marked locked\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.isLocked).to.be.true;",
                  "    pm.expect(json.data.canEdit).to.be.false;",
                  "    pm.expect(json.data.lockReason).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
